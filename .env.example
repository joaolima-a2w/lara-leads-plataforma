# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados reais do banco.
# O ".env" já está no .gitignore — nunca vai pro git.

# --- Supabase (via @supabase/server, HTTPS — caminho recomendado) ---
# Pega esses valores em Project Settings > API Keys no dashboard da Supabase.
# SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY não são segredos. SUPABASE_SECRET_KEY é
# equivalente à service_role key: nunca exponha no frontend, só o backend usa.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json

# --- Postgres direto (opcional, via pg — só necessário se precisar de SQL bruto) ---
# Opção A: uma única connection string (Supabase/Neon/RDS já te dão isso pronto)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Se o seu provedor exigir SSL (comum em bancos hospedados: Supabase, Neon, RDS, Azure...), deixe "true".
# Se for um Postgres local sem SSL, mude para "false".
DATABASE_SSL=true
